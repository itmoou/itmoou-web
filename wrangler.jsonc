{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "itmoou-webpage",
	"compatibility_date": "2026-01-24",
	"pages_build_output_dir": "./dist",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "itmoou_db",
			"database_name": "itmoou-db",
			"database_id": "07ade62a-7773-4144-bcf7-597158ad6bdc",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "itmoou_files",
			"bucket_name": "itmoou-files",
			"remote": true
		}
	]
}
